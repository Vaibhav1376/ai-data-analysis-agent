# OpenAI API Key (Required when using OpenAI models like gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Required when using Gemini models like gemini-2.0-flash, gemini-1.5-pro)
GEMINI_API_KEY=your_gemini_api_key_here
